/.gemini/oauth_creds.json
/.gemini/google_accounts.json
/.opencode/auth.json
/.config/opencode/auth.json
/.local/share/opencode/auth.json

# Dependências, caches e resultados locais; sem ocultar recursos de Skills/.
/node_modules/
/.venv/
/venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/logs/
/*.log
/.coverage
/.coverage.*
/coverage/
/htmlcov/
